<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1000" width="100%" height="100%">
  <!-- Definições de Estilos CSS -->
  <style>
    .grid-line { stroke: #E2E8F0; stroke-width: 0.5; stroke-dasharray: 2 4; }
    .wire { fill: none; stroke: #475569; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    .wire-pwr-48v { fill: none; stroke: #DC2626; stroke-width: 2.5; stroke-linecap: round; }
    .wire-pwr-5v { fill: none; stroke: #F59E0B; stroke-width: 2; stroke-linecap: round; }
    .wire-pwr-3v3 { fill: none; stroke: #10B981; stroke-width: 2; stroke-linecap: round; }
    .wire-gnd { fill: none; stroke: #1E3A8A; stroke-width: 2.5; stroke-linecap: round; }
    .wire-gate { fill: none; stroke: #8B5CF6; stroke-width: 1.5; stroke-linecap: round; }
    .wire-analog { fill: none; stroke: #D97706; stroke-width: 1.5; stroke-linecap: round; }
    .ic-box { fill: #F8FAFC; stroke: #1E293B; stroke-width: 2.5; rx: 8px; }
    .block-box { fill: #F1F5F9; stroke: #475569; stroke-width: 1.5; stroke-dasharray: 4 4; rx: 6px; }
    .comp-line { fill: none; stroke: #1E293B; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .text-title { font-family: 'Courier New', monospace; font-size: 16px; font-weight: bold; fill: #0F172A; }
    .text-subtitle { font-family: sans-serif; font-size: 12px; fill: #475569; font-weight: 500; }
    .text-pin { font-family: monospace; font-size: 11px; fill: #334155; font-weight: bold; }
    .text-comp-label { font-family: sans-serif; font-size: 10px; fill: #475569; font-weight: bold; }
    .text-net { font-family: monospace; font-size: 10px; fill: #2563EB; font-weight: bold; }
    .junction { fill: #1E293B; }
    .junction-pwr { fill: #DC2626; }
    .junction-gnd { fill: #1E3A8A; }
  </style>

  <!-- Definições de Componentes Reutilizáveis (Templates) -->
  <defs>
    <!-- Grade de Fundo (CAD Style) -->
    <pattern id="cad-grid" width="50" height="50" patternUnits="userSpaceOnUse">
      <path d="M 50 0 L 0 0 0 50" fill="none" stroke="#F1F5F9" stroke-width="1"/>
      <circle cx="0" cy="0" r="1" fill="#CBD5E1"/>
    </pattern>

    <!-- Símbolo: MOSFET Canal N -->
    <g id="n_mosfet">
      <path d="M 0,-30 L 0,-15" class="comp-line"/> <!-- Drain -->
      <path d="M 0,15 L 0,30" class="comp-line"/> <!-- Source -->
      <path d="M -30,0 L -15,0" class="comp-line"/> <!-- Gate -->
      <path d="M -15,-20 L -15,20" class="comp-line" stroke-width="3"/> <!-- Placa do Gate -->
      <path d="M -8,-20 L -8,-8" class="comp-line" stroke-width="3"/> <!-- Segmento Drain -->
      <path d="M -8,-6 L -8,6" class="comp-line" stroke-width="3"/> <!-- Segmento Bulk -->
      <path d="M -8,8 L -8,20" class="comp-line" stroke-width="3"/> <!-- Segmento Source -->
      <path d="M -8,-14 L 0,-14" class="comp-line"/> <!-- Conexão interna Drain -->
      <path d="M -8,14 L 0,14" class="comp-line"/> <!-- Conexão interna Source -->
      <path d="M -8,0 L 0,0 L 0,14" class="comp-line" fill="none"/> <!-- Bulk para Source -->
      <polygon points="-8,0 -16,-4 -16,4" fill="#1E293B"/> <!-- Seta de Canal N -->
    </g>

    <!-- Símbolo: Resistor Horizontal -->
    <g id="resistor_h">
      <path d="M 0,0 L 10,0 L 13,-6 L 19,6 L 25,-6 L 31,6 L 37,-6 L 43,6 L 47,0 L 57,0" fill="none" stroke="#1E293B" stroke-width="2"/>
    </g>

    <!-- Símbolo: Resistor Vertical -->
    <g id="resistor_v">
      <path d="M 0,0 L 0,10 L -6,13 L 6,19 L -6,25 L 6,31 L -6,37 L 6,43 L 0,47 L 0,57" fill="none" stroke="#1E293B" stroke-width="2"/>
    </g>

    <!-- Símbolo: Capacitor Não-Polarizado Vertical -->
    <g id="cap_v">
      <path d="M 0,0 L 0,16" class="comp-line"/>
      <path d="M -12,16 L 12,16" class="comp-line" stroke-width="3"/>
      <path d="M -12,21 L 12,21" class="comp-line" stroke-width="3"/>
      <path d="M 0,21 L 0,37" class="comp-line"/>
    </g>

    <!-- Símbolo: Capacitor Eletrolítico Vertical -->
    <g id="cap_pol_v">
      <path d="M 0,0 L 0,15" class="comp-line"/>
      <path d="M -12,15 L 12,15" class="comp-line" stroke-width="3"/> <!-- Positivo -->
      <path d="M -12,20 C -6,22 6,22 12,20" fill="none" stroke="#1E293B" stroke-width="2"/> <!-- Negativo Curvo -->
      <path d="M 0,20 L 0,35" class="comp-line"/>
      <text x="14" y="12" class="text-comp-label" fill="#DC2626">+</text>
    </g>

    <!-- Símbolo: Diodo de Potência Vertical -->
    <g id="diode_v">
      <path d="M 0,0 L 0,15" class="comp-line"/>
      <polygon points="-10,15 10,15 0,27" fill="#1E293B"/>
      <path d="M -10,27 L 10,27" class="comp-line" stroke-width="2"/>
      <path d="M 0,27 L 0,42" class="comp-line"/>
    </g>

    <!-- Símbolo: TVS Vertical (Supressor de Transiente) -->
    <g id="tvs_v">
      <path d="M 0,0 L 0,14" class="comp-line"/>
      <path d="M -12,14 L 12,14" class="comp-line" stroke-width="3"/>
      <polygon points="-10,14 10,14 0,26" fill="#1E293B"/>
      <path d="M -10,26 L 10,26" class="comp-line" stroke-width="2"/>
      <path d="M 0,26 L 0,40" class="comp-line"/>
      <path d="M 8,10 L 12,14 L 8,18" fill="none" stroke="#1E293B" stroke-width="1.5"/>
      <path d="M -8,22 L -12,26 L -8,30" fill="none" stroke="#1E293B" stroke-width="1.5"/>
    </g>

    <!-- Símbolo: Indutor Horizontal -->
    <g id="inductor_h">
      <path d="M 0,0 L 7,0 C 9,-8 15,-8 17,0 C 19,-8 25,-8 27,0 C 29,-8 35,-8 37,0 C 39,-8 45,-8 47,0 L 57,0" fill="none" stroke="#1E293B" stroke-width="2"/>
    </g>
  </defs>

  <!-- Aplicar Grade de Fundo -->
  <rect width="100%" height="100%" fill="url(#cad-grid)" stroke="#CBD5E1" stroke-width="2"/>

  <!-- BARRAMENTOS PRINCIPAIS -->
  <path d="M 50,100 L 1520,100" class="wire-pwr-48v"/> <!-- VDC (48V) -->
  <text x="60" y="90" class="text-pin" fill="#DC2626">DC_LINK (+12V a +48V BARRAMENTO INDUSTRIAL)</text>

  <path d="M 50,900 L 1520,900" class="wire-gnd"/> <!-- GND -->
  <text x="60" y="920" class="text-pin" fill="#1E3A8A">GND_POWER_PLANE</text>

  <!-- ========================================== -->
  <!-- BLOCO 1: ENTRADA DE POTÊNCIA & PRÉ-CARGA -->
  <!-- ========================================== -->
  <g id="bloco_entrada" transform="translate(0,0)">
    <!-- Conector de Entrada Robusto XT90 -->
    <rect x="50" y="180" width="70" height="90" rx="4" fill="#F59E0B" stroke="#D97706" stroke-width="2.5"/>
    <text x="85" y="215" class="text-title" fill="#FFF" text-anchor="middle">XT90</text>
    <text x="85" y="245" class="text-subtitle" fill="#FFF" text-anchor="middle">Heavy-Duty</text>
    
    <!-- Fusível Principal de Alta Capacidade (FUSE1 - 50A) -->
    <g transform="translate(190, 100)">
      <rect x="-25" y="-15" width="50" height="30" rx="3" fill="#FFE4E6" stroke="#DC2626" stroke-width="2"/>
      <path d="M -35,0 L -25,0 C -10,-10 10,10 25,0 L 35,0" fill="none" stroke="#DC2626" stroke-width="2.5"/>
      <text x="0" y="-22" class="text-comp-label" text-anchor="middle">FUSE 50A</text>
    </g>
    <path d="M 120,200 L 155,200 L 155,100" class="wire-pwr-48v"/>
    <circle cx="155" cy="100" r="4" class="junction-pwr"/>

    <path d="M 120,240 L 135,240 L 135,900" class="wire-gnd"/>
    <circle cx="135" cy="900" r="4" class="junction-gnd"/>

    <!-- Estágio de Pré-Carga Ativa (Pre-charge) -->
    <g id="circuito_precharge" transform="translate(240, 100)">
      <!-- Chave/Contator do Relé K_pre -->
      <rect x="25" y="-15" width="50" height="30" rx="3" fill="#FFF" stroke="#1E293B" stroke-width="1.5"/>
      <path d="M 25,0 L 40,0 M 40,-10 L 60,10 M 60,0 L 75,0" class="wire"/>
      <text x="50" y="-22" class="text-comp-label" text-anchor="middle">K_pre</text>
      <text x="50" y="25" class="text-subtitle" text-anchor="middle" font-size="8px">Contator Bypass</text>

      <!-- Resistor Cerâmico de Pré-Carga (R_pre) em paralelo -->
      <path d="M 10,0 L 10,-40 L 25,-40" class="wire"/>
      <use href="#resistor_h" x="25" y="-40"/>
      <text x="53" y="-50" class="text-comp-label" text-anchor="middle">R_pre (10R 25W)</text>
      <path d="M 82,-40 L 95,-40 L 95,0" class="wire"/>
      <circle cx="10" cy="0" r="3" class="junction"/>
      <circle cx="95" cy="0" r="3" class="junction"/>
    </g>
    <circle cx="250" cy="100" r="4" class="junction-pwr"/>
    <circle cx="335" cy="100" r="4" class="junction-pwr"/>

    <!-- Filtro de Entrada de Modo Comum (EMI Choke) -->
    <g transform="translate(370, 80)">
      <!-- Enrolamento Linha Positiva -->
      <path d="M 0,20 C 5,10 15,10 20,20 C 25,10 35,10 40,20 C 45,10 55,10 60,20" fill="none" stroke="#DC2626" stroke-width="2.5"/>
      <!-- Núcleo Ferrite -->
      <rect x="5" y="23" width="50" height="4" fill="#64748B"/>
      <!-- Enrolamento Linha GND -->
      <path d="M 0,30 C 5,40 15,40 20,30 C 25,40 35,40 40,30 C 45,40 55,40 60,30" fill="none" stroke="#1E3A8A" stroke-width="2.5"/>
      <text x="30" y="8" class="text-comp-label" text-anchor="middle">EMI CHOKE</text>
    </g>
    <!-- Conectar saídas do Choke aos barramentos -->
    <circle cx="370" cy="100" r="4" class="junction-pwr"/>
    <circle cx="370" cy="900" r="4" class="junction-gnd"/>
    <path d="M 370,900 L 430,900" class="wire-gnd"/>
    <circle cx="430" cy="900" r="4" class="junction-gnd"/>

    <!-- Banco de Capacitores e TVS industrial pós-filtro -->
    <use href="#tvs_v" x="460" y="100"/>
    <path d="M 460,150 L 460,900" class="wire-gnd"/>
    <circle cx="460" cy="100" r="4" class="junction-pwr"/>
    <circle cx="460" cy="900" r="4" class="junction-gnd"/>
    
    <use href="#cap_pol_v" x="520" y="100"/>
    <path d="M 520,135 L 520,900" class="wire-gnd"/>
    <circle cx="520" cy="100" r="4" class="junction-pwr"/>
    <circle cx="520" cy="900" r="4" class="junction-gnd"/>
  </g>

  <!-- ========================================== -->
  <!-- NOVO SUBSISTEMA: CIRCUITO DE FREIO MOTOR (REOSTÁTICO) -->
  <!-- ========================================== -->
  <g id="circuito_freio" transform="translate(580, 0)">
    <rect x="-15" y="70" width="165" height="420" class="block-box" fill="#FFF5F5" stroke="#FCA5A5"/>
    <text x="65" y="60" class="text-title" fill="#DC2626" text-anchor="middle">CHOPPER DE FREIO</text>

    <!-- Resistor de Carga do Freio (R_brake - Reostato 10R 100W) -->
    <use href="#resistor_v" x="50" y="100"/>
    <text x="90" y="125" class="text-comp-label">R_brake</text>
    <text x="90" y="137" class="text-subtitle" fill="#DC2626">10R 100W Alumínio</text>
    <circle cx="50" cy="100" r="4" class="junction-pwr"/>

    <!-- Diodo de Roda Livre Rápido (D_brake) em paralelo com o resistor de freio -->
    <!-- Ele aponta para cima (catodo no barramento positivo 48V) -->
    <g transform="translate(10, 142) scale(1, -1)">
      <use href="#diode_v" x="0" y="0"/>
    </g>
    <text x="-35" y="125" class="text-comp-label">D_brake (MURS360)</text>
    <path d="M 10,100 L 10,102 M 10,142 L 10,157 L 50,157" class="wire"/>
    <circle cx="10" cy="100" r="3" class="junction"/>
    <circle cx="50" cy="157" r="3" class="junction"/>

    <!-- Chave Chaveadora N-MOS (Q_brake - IRFB4110) -->
    <use href="#n_mosfet" x="50" y="270"/>
    <text x="75" y="240" class="text-comp-label">Q_brake</text>
    <text x="75" y="252" class="text-subtitle">IRFB4110</text>
    <path d="M 50,157 L 50,240" class="wire"/> <!-- Conecta Resistor ao Dreno do Mosfet -->

    <!-- Resistores de Controle de Gate do Freio -->
    <use href="#resistor_h" x="-10" y="270"/>
    <text x="15" y="260" class="text-comp-label">47R</text>
    <text x="-65" y="274" class="text-net" fill="#8B5CF6">BRAKE_CTRL</text>

    <!-- Resistor Pull-down de Gate (10k) -->
    <use href="#resistor_v" x="25" y="300"/>
    <path d="M 25,270 L 25,300" class="wire"/>
    <circle cx="25" cy="270" r="3" class="junction"/>
    <path d="M 25,357 L 25,380 L 50,380" class="wire"/>
    <circle cx="50" cy="380" r="3" class="junction"/>

    <!-- Saída do Mosfet de Freio para o barramento GND -->
    <path d="M 50,300 L 50,900" class="wire-gnd"/>
    <circle cx="50" cy="900" r="4" class="junction-gnd"/>
  </g>

  <!-- ========================================== -->
  <!-- BLOCO 3: GATE DRIVER PRINCIPAL (TI DRV8302) -->
  <!-- ========================================== -->
  <g id="bloco_driver" transform="translate(750, 180)">
    <!-- Chassis do DRV8302 -->
    <rect x="0" y="0" width="200" height="420" class="ic-box" fill="#F8FAFC"/>
    <rect x="0" y="0" width="200" height="40" fill="#E2E8F0" rx="8"/>
    <text x="100" y="25" class="text-title" text-anchor="middle">TI DRV8302</text>

    <!-- Pinos Lado Esquerdo -->
    <text x="10" y="80" class="text-pin">PVDD</text>
    <text x="10" y="110" class="text-pin">GND</text>
    <text x="10" y="145" class="text-pin">PWM_UH</text>
    <text x="10" y="165" class="text-pin">PWM_UL</text>
    <text x="10" y="195" class="text-pin">PWM_VH</text>
    <text x="10" y="215" class="text-pin">PWM_VL</text>
    <text x="10" y="245" class="text-pin">PWM_WH</text>
    <text x="10" y="265" class="text-pin">PWM_WL</text>
    <text x="10" y="300" class="text-pin">FAULT</text>
    <text x="10" y="340" class="text-pin">EN_GATE</text>

    <!-- Pinos Lado Direito -->
    <text x="190" y="70" class="text-pin" text-anchor="end">GVDD (8V)</text>
    <text x="190" y="100" class="text-pin" text-anchor="end">GH_A</text>
    <text x="190" y="120" class="text-pin" text-anchor="end">SH_A</text>
    <text x="190" y="140" class="text-pin" text-anchor="end">GL_A</text>
    
    <text x="190" y="180" class="text-pin" text-anchor="end">GH_B</text>
    <text x="190" y="200" class="text-pin" text-anchor="end">SH_B</text>
    <text x="190" y="220" class="text-pin" text-anchor="end">GL_B</text>

    <text x="190" y="260" class="text-pin" text-anchor="end">GH_C</text>
    <text x="190" y="280" class="text-pin" text-anchor="end">SH_C</text>
    <text x="190" y="300" class="text-pin" text-anchor="end">GL_C</text>

    <text x="190" y="350" class="text-pin" text-anchor="end">SO1 (AMP_U)</text>
    <text x="190" y="375" class="text-pin" text-anchor="end">SO2 (AMP_V)</text>

    <!-- Barramento PVDD -->
    <path d="M -15,80 L 0,80" class="wire-pwr-48v"/>
    <path d="M -15,80 L -15,-80" class="wire-pwr-48v"/>
    <circle cx="-15" cy="-80" r="4" class="junction-pwr"/>

    <path d="M -5,110 L 0,110" class="wire-gnd"/>
  </g>

  <!-- ========================================== -->
  <!-- BLOCO 4: MICROCONTROLADOR (ESP32-WROOM-32E) -->
  <!-- ========================================== -->
  <g id="bloco_mcu" transform="translate(100, 520)">
    <!-- Chassis do ESP32 -->
    <rect x="0" y="0" width="280" height="340" class="ic-box" fill="#F8FAFC"/>
    <rect x="0" y="0" width="280" height="40" fill="#E2E8F0" rx="8" />
    <text x="140" y="25" class="text-title" text-anchor="middle">ESP32-WROOM-32E</text>

    <!-- Pinos Lado Esquerdo -->
    <text x="10" y="80" class="text-pin">3.3V</text>
    <text x="10" y="110" class="text-pin">GND</text>
    <text x="10" y="140" class="text-pin">GPIO34 (VDC_SENSE)</text>
    <text x="10" y="170" class="text-pin">GPIO35 (TEMP_MOT)</text>
    <text x="10" y="200" class="text-pin">GPIO32 (TEMP_DRV)</text>
    <text x="10" y="230" class="text-pin">GPIO33 (HALL_A)</text>
    <text x="10" y="260" class="text-pin">GPIO25 (HALL_B)</text>
    <text x="10" y="290" class="text-pin">GPIO26 (HALL_C)</text>

    <!-- Pinos Lado Direito -->
    <text x="270" y="80" class="text-pin" text-anchor="end">PWM_UH (GPIO12)</text>
    <text x="270" y="110" class="text-pin" text-anchor="end">PWM_UL (GPIO13)</text>
    <text x="270" y="140" class="text-pin" text-anchor="end">PWM_VH (GPIO14)</text>
    <text x="270" y="170" class="text-pin" text-anchor="end">PWM_VL (GPIO27)</text>
    <text x="270" y="200" class="text-pin" text-anchor="end">PWM_WH (GPIO15)</text>
    <text x="270" y="230" class="text-pin" text-anchor="end">PWM_WL (GPIO)</text>
    <text x="270" y="260" class="text-pin" text-anchor="end">I_S_U (GPIO4)</text>
    <text x="270" y="280" class="text-pin" text-anchor="end">I_S_V (GPIO5)</text>
    <text x="270" y="300" class="text-pin" text-anchor="end">CAN_TX (GPIO21)</text>
    <text x="270" y="320" class="text-pin" text-anchor="end">CAN_RX (GPIO22)</text>

    <path d="M -40,80 L 0,80" class="wire-pwr-3v3"/>
    <path d="M -40,110 L 0,110" class="wire-gnd"/>
  </g>

  <!-- ========================================== -->
  <!-- NOVO: BARRAMENTO ISOLADO DE COMUNICAÇÃO CAN (ISO1050) -->
  <!-- ========================================== -->
  <g id="can_isolation" transform="translate(430, 750)">
    <rect x="0" y="0" width="250" height="110" class="ic-box" fill="#ECFDF5" stroke="#10B981" stroke-width="2"/>
    <text x="125" y="22" class="text-title" font-size="12px" text-anchor="middle" fill="#10B981">ISO1050 (Transceptor CAN Isolado)</text>
    <text x="10" y="55" class="text-pin">TXD</text>
    <text x="10" y="75" class="text-pin">RXD</text>
    <text x="10" y="95" class="text-pin">GND1</text>
    
    <text x="240" y="55" class="text-pin" text-anchor="end">CANH</text>
    <text x="240" y="75" class="text-pin" text-anchor="end">CANL</text>
    <text x="240" y="95" class="text-pin" text-anchor="end">GND2 (ISO)</text>

    <!-- Conector de Barramento Industrial CAN -->
    <rect x="280" y="35" width="50" height="55" rx="3" fill="#047857" stroke="#065F46"/>
    <text x="305" y="55" class="text-title" font-size="10px" fill="#FFF" text-anchor="middle">H</text>
    <text x="305" y="75" class="text-title" font-size="10px" fill="#FFF" text-anchor="middle">L</text>
    <path d="M 250,50 L 280,50" class="wire"/>
    <path d="M 250,70 L 280,70" class="wire"/>
  </g>

  <!-- ========================================== -->
  <!-- PONTE INVERSORA TRIFÁSICA COM SNUBBERS RC -->
  <!-- ========================================== -->
  
  <!-- FASE U -->
  <g id="fase_u" transform="translate(1000, 150)">
    <rect x="-35" y="0" width="135" height="580" class="block-box" fill="#FFF"/>
    <text x="32" y="-15" class="text-title" text-anchor="middle">PHASE U</text>

    <!-- MOSFET High-Side Q1 -->
    <use href="#n_mosfet" x="30" y="100"/>
    <text x="55" y="70" class="text-comp-label">Q1 (HS)</text>
    <path d="M 30,0 L 30,70" class="wire-pwr-48v"/>
    <circle cx="30" cy="-50" r="4" class="junction-pwr"/>

    <!-- NOVO: RC Snubber High-Side (Atenuador de dv/dt de Chaveamento) -->
    <g transform="translate(-25, 60)">
      <rect x="0" y="0" width="45" height="80" class="block-box" fill="#F8FAFC" stroke-dasharray="2 2"/>
      <use href="#resistor_v" x="15" y="10"/>
      <use href="#cap_v" x="15" y="55"/>
      <text x="20" y="8" class="text-comp-label" font-size="6px">2.2R</text>
      <text x="20" y="53" class="text-comp-label" font-size="6px">10nF</text>
    </g>
    <!-- Conectar Snubber em paralelo com Dreno e Source do Q1 -->
    <path d="M -10,70 L 30,70" class="wire"/>
    <circle cx="30" cy="70" r="3" class="junction"/>
    <path d="M -10,152 L -10,200 L 30,200" class="wire"/>
    <circle cx="30" cy="200" r="3" class="junction"/>

    <!-- Gate Resistor HS -->
    <use href="#resistor_h" x="-30" y="100"/>
    <text x="-65" y="104" class="text-net" fill="#8B5CF6">GH_U</text>

    <!-- Bootstrap Capacitor -->
    <use href="#cap_v" x="75" y="130"/>
    <path d="M 75,130 L 75,110 L 30,110" class="wire"/>
    <circle cx="30" cy="110" r="3" class="junction"/>
    <path d="M 75,167 L 75,200 L 30,200" class="wire"/>
    <circle cx="30" cy="200" r="3" class="junction"/>

    <!-- MOSFET Low-Side Q4 -->
    <use href="#n_mosfet" x="30" y="320"/>
    <text x="55" y="290" class="text-comp-label">Q4 (LS)</text>
    <path d="M 30,200 L 30,290" class="wire"/>

    <!-- RC Snubber Low-Side -->
    <g transform="translate(-25, 280)">
      <rect x="0" y="0" width="45" height="80" class="block-box" fill="#F8FAFC" stroke-dasharray="2 2"/>
      <use href="#resistor_v" x="15" y="10"/>
      <use href="#cap_v" x="15" y="55"/>
